        "nl": {
          "titleText": "AI-powergebruiker? Upgraden naar Pro!",
          "descriptionText": "Pro biedt exclusieve AI-modellen (Opus 4.8, GPT-5.6 Sol), verbeterde redenering en 2 × hogere limieten. Geschikt voor complexere taken en diepgaande analyse.",
          "primaryActionText": "Upgraden naar Pro"
        },
        "pl": {
          "titleText": "Zaawansowany użytkownik AI? Przejdź na plan Pro!",
          "descriptionText": "Plan Pro oferuje ekskluzywne modele AI (Opus 4.8, GPT-5.6 Sol), lepsze możliwości rozumowania i dwukrotnie wyższe limity. Do bardziej złożonych zadań i dogłębnej analizy.",
          "primaryActionText": "Przejdź na plan Pro"
        },
        "pt": {
          "titleText": "Utilizador avançado de IA? Atualizar para o Pro!",
          "descriptionText": "O Pro tem modelos de IA exclusivos (Opus 4.8, GPT-5.6 Sol), raciocínio melhorado e limites 2x superiores. Adequado para tarefas mais complexas e análises aprofundadas.",
          "primaryActionText": "Atualizar para o Pro"
